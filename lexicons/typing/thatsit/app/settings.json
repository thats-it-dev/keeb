{
	"lexicon": 1,
	"id": "app.thatsit.typing.settings",
	"defs": {
		"main": {
			"description": "Which board and keymap this learner is practising, and how fast they want to be. One record per account.",
			"type": "record",
			"key": "literal:self",
			"record": {
				"type": "object",
				"required": [
					"geometry",
					"keymap",
					"targetCpm",
					"updatedAt"
				],
				"properties": {
					"geometry": {
						"type": "string",
						"maxGraphemes": 100
					},
					"keymap": {
						"type": "string",
						"maxGraphemes": 100
					},
					"targetCpm": {
						"type": "integer"
					},
					"updatedAt": {
						"type": "integer"
					},
					"unlocked": {
						"type": "array",
						"items": {
							"type": "string",
							"maxGraphemes": 20
						},
						"maxLength": 200
					}
				}
			}
		}
	}
}
