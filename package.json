{
	"name": "keeb",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"kit-types": "node scripts/kit-types.ts",
		"predev": "npm run kit-types",
		"dev": "vite",
		"prebuild": "npm run kit-types",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"pretypecheck": "npm run kit-types",
		"typecheck": "tsc",
		"test": "vitest run",
		"e2e": "playwright test",
		"icons": "node scripts/make-icons.ts",
		"e2e:one": "playwright test --project=desktop",
		"lint": "knip --no-progress",
		"verify": "npm run typecheck && npm test && npm run lint && npm run e2e",
		"lexicons": "node scripts/export-lexicons.ts",
		"lexicons:publish": "npm run lexicons && goat lex publish"
	},
	"devDependencies": {
		"@atproto/lexicon": "^0.7.19",
		"@atproto/oauth-types": "^0.7.7",
		"@playwright/test": "1.64.0",
		"@types/node": "24.19.2",
		"knip": "5.88.1",
		"lit": "3.3.3",
		"lucide": "^1.67.0",
		"typescript": "5.9.3",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"@atproto/common-web": "^0.5.16",
		"@atproto/oauth-client-browser": "^0.5.11"
	}
}
